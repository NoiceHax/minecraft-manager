# Copy to .env for local development. Never commit a filled-in .env.
# Deployment on the homelab reads secrets from files under /run/secrets instead
# (see deploy/docker-compose.yml); env vars are the local-dev convenience path.

# --- config selection -------------------------------------------------------
# Path to the TOML config the daemon should load.
MCM_CONFIG_FILE=config/mcmanager.dev.toml

# Directory of file-based secrets. Each file is named after the setting it fills
# (discord_token, web_token, rcon_password). Takes precedence over TOML.
# MCM_SECRETS_DIR=/run/secrets

# --- docker -----------------------------------------------------------------
# Unset on the homelab (the socket is bind-mounted at /var/run/docker.sock).
# From a Windows dev box, point it at the homelab to run the standalone CLI:
# DOCKER_HOST=ssh://minty@192.168.1.7

# --- overrides (MCM_ prefix, __ nests) --------------------------------------
# MCM_RUNTIME=fake
# MCM_LOGS__LEVEL=DEBUG
# MCM_SERVER__HOST=minecraft
# MCM_IDLE__ENABLED=false

# --- secrets (dev only; prefer MCM_SECRETS_DIR) -----------------------------
# MCM_DISCORD__TOKEN=
# MCM_WEB__TOKEN=

# --- CLI --------------------------------------------------------------------
# Where `mcmanager status` / `events` look for a running daemon.
# MCMANAGER_URL=http://127.0.0.1:8787

# Set to 1 to allow the @pytest.mark.live tests to touch the real homelab.
# MCMANAGER_LIVE=0
